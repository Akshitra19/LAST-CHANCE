{
  "name": "@last-chance/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "verify:db": "tsx src/scripts/verify-db.ts",
    "verify:api": "tsx src/scripts/verify-api.ts",
    "verify:planner": "tsx src/scripts/verify-planner.ts",
    "setup:question-storage": "tsx src/scripts/setup-question-storage.ts",
    "verify:questions": "tsx src/scripts/verify-questions.ts",
    "verify:tests": "tsx src/scripts/verify-tests.ts",
    "verify:attempts": "tsx src/scripts/verify-attempts.ts",
    "verify:scoring": "tsx src/scripts/verify-scoring.ts",
    "verify:results": "tsx src/scripts/verify-results.ts",
    "verify:analytics": "tsx src/scripts/verify-analytics.ts",
    "validate:seed": "tsx src/scripts/validate-seed.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.5.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
