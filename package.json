{
  "name": "last-chance",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names CLIENT,SERVER --prefix-colors cyan,magenta \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server",
    "verify:db": "npm run verify:db --workspace server",
    "verify:api": "npm run verify:api --workspace server",
    "verify:planner": "npm run verify:planner --workspace server",
    "setup:question-storage": "npm run setup:question-storage --workspace server",
    "verify:questions": "npm run verify:questions --workspace server",
    "verify:tests": "npm run verify:tests --workspace server",
    "verify:attempts": "npm run verify:attempts --workspace server",
    "verify:scoring": "npm run verify:scoring --workspace server",
    "validate:seed": "npm run validate:seed --workspace server"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "supabase": "2.117.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "13.0.6"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
